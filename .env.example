# Configurazione email per AlrtEtf (OPZIONALE)
#
# AlrtEtf puo inviare gli alert tramite Autoclaw (Gmail gia connesso).
# In quel caso NON serve compilare questo file: basta copiare .env.example in .env
# lasciando i segnaposto, e gli alert verranno accodati in outbox/.
#
# Compila solo se vuoi l'invio SMTP diretto, senza passare da Autoclaw.
# Per Gmail serve una "Password delle app" (16 caratteri), non la password account.

SMTP_USER=tuo-indirizzo@gmail.com
SMTP_PASSWORD=la-tua-app-password
